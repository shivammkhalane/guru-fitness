VITE_APP_MODE=mock
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GYM_NAME="Guru Fitness Health Club"
VITE_GYM_LOCATION="Dhule, Maharashtra, India"
VITE_DEFAULT_CURRENCY="INR"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
VITE_GYM_WHATSAPP_NUMBER=
VITE_GYM_INSTAGRAM_URL=

# For production use, set VITE_APP_MODE=supabase and provide a real Supabase URL and anon key.
# Do not use a Supabase service-role key in the browser.
# Member portal contact buttons remain unavailable until the gym's public contact details are configured.
# NEVER commit .env.local to Git — it is listed in .gitignore.
